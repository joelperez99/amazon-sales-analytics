# =============================================================================
# Amazon Sales Analytics - variables de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env al repositorio.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_NAME="Amazon Sales Analytics"
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
TIMEZONE=America/Mexico_City

# --- Base de datos -----------------------------------------------------------
# Desarrollo local con SQLite (opción por defecto, no requiere instalación):
DATABASE_URL=sqlite:///./data/amazon_analytics.db
#
# Producción con PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://amazon:amazon@localhost:5432/amazon_analytics
#
# Con docker-compose (el host es el nombre del servicio):
# DATABASE_URL=postgresql+psycopg2://amazon:amazon@db:5432/amazon_analytics

DB_ECHO=false                 # true para registrar el SQL generado (solo depuración)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Autenticación -----------------------------------------------------------
AUTH_ENABLED=true             # false = modo abierto sin login (solo desarrollo)
DEMO_MODE=true                # crea el usuario demo y habilita el botón "datos de ejemplo"
DEMO_EMAIL=demo@amazonanalytics.mx
DEMO_PASSWORD=Demo1234!
SESSION_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
SESSION_TIMEOUT_MINUTES=480
PASSWORD_MIN_LENGTH=8

# --- Almacenamiento de archivos ---------------------------------------------
STORAGE_BACKEND=local         # local | s3 | supabase
STORAGE_LOCAL_PATH=./data/uploads
FILE_RETENTION_DAYS=365       # 0 = sin caducidad

# Amazon S3 (solo si STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supabase (solo si STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=reportes

# --- Límites de carga --------------------------------------------------------
MAX_FILE_SIZE_MB=200
ALLOWED_EXTENSIONS=.csv,.xlsx,.xls
CSV_CHUNK_SIZE=100000         # filas por bloque al leer CSV grandes

# --- Umbrales de alertas -----------------------------------------------------
ALERTA_CAIDA_VENTAS_PCT=15          # alerta si las ventas caen más de este %
ALERTA_TASA_REEMBOLSO_PCT=5         # alerta si la tasa de reembolso supera este %
ALERTA_PCT_CARGOS_PCT=35            # alerta si los cargos superan este % de las ventas
ALERTA_CONCENTRACION_SKU_PCT=40     # alerta si un SKU concentra más de este % de ventas
ALERTA_DIAS_SIN_VENTA=7             # alerta si un SKU deja de venderse estos días
ALERTA_TOLERANCIA_CONCILIACION=1.0  # diferencia máxima aceptada en MXN

# --- Facturación (Stripe) ----------------------------------------------------
BILLING_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
